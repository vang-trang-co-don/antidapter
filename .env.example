# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Required: obtain an OAuth 2.0 "Desktop"/"Installed app" client from Google
# Cloud Console with the Cloud Code (aicode) scope enabled. These are NOT the
# same as an API key and must not be shared publicly.
ANTIDAPTER_CLIENT_ID=
ANTIDAPTER_CLIENT_SECRET=

# --- Server ---
# Bind to a non-loopback address only together with an API key.
# ANTIDAPTER_HOST=127.0.0.1
# ANTIDAPTER_PORT=8080
# When set, callers must send `Authorization: Bearer <key>`.
# ANTIDAPTER_API_KEY=
# ANTIDAPTER_MAX_REQUEST_BYTES=33554432
# Set to false so a request thread never blocks on a browser login.
# ANTIDAPTER_ALLOW_INTERACTIVE_LOGIN=true
# ANTIDAPTER_LOG_LEVEL=INFO

# --- Upstream ---
# ANTIDAPTER_UPSTREAM_URL=https://daily-cloudcode-pa.googleapis.com
# ANTIDAPTER_PROJECT_ID=aicode-consumers
# ANTIDAPTER_USER_AGENT=antigravity
# ANTIDAPTER_UPSTREAM_TIMEOUT=300
# ANTIDAPTER_MAX_RETRIES=3
# ANTIDAPTER_RETRY_BASE_DELAY=0.5
# ANTIDAPTER_RETRY_MAX_DELAY=8

# --- OAuth ---
# ANTIDAPTER_LOGIN_TIMEOUT=180
# ANTIDAPTER_OAUTH_TIMEOUT=30

# --- Storage / protocol ---
# ANTIDAPTER_CONFIG_DIR=~/.config/antidapter
# ANTIDAPTER_CREDENTIALS_FILE=credentials.json
# ANTIDAPTER_KEYRING_SERVICE=gemini
# ANTIDAPTER_KEYRING_USERNAME=antigravity
# ANTIDAPTER_DEFAULT_MODEL=gemini-3.6-flash-low
# ANTIDAPTER_EMIT_REASONING=true
